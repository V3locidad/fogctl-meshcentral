<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>FOG Control</title>
<style>
  :root { color-scheme: light; --ink:#1c2b40; --muted:#617188; --line:#dde5ee; --blue:#205dcc; --soft:#edf4ff; }
  * { box-sizing:border-box; }
  [hidden] { display:none !important; }
  html, body { margin:0; min-height:100%; }
  body { font:13px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; color:var(--ink); background:#f4f7fb; padding:18px; }
  .app { max-width:1800px; margin:auto; }
  h1,h2,h3,p { margin:0; }
  h1 { font-size:21px; letter-spacing:-.6px; font-weight:700; }
  h2 { font-size:14px; font-weight:650; display:flex; align-items:center; gap:9px; }
  h3 { font-size:12px; font-weight:650; }
  .muted,.help { color:var(--muted); }
  .help { font-size:12px; }
  .app-head { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:16px; }
  .brand { display:flex; align-items:center; gap:12px; }
  .brand-mark { width:39px; height:39px; display:grid; place-items:center; border-radius:10px; color:white; background:var(--blue); font-size:22px; font-weight:750; }
  .head-actions { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
  button,input,select { font:inherit; }
  button { min-height:33px; padding:6px 11px; border:1px solid var(--line); border-radius:6px; color:var(--ink); background:white; cursor:pointer; font-weight:550; }
  button:hover { background:#f3f6fb; border-color:#b7c7da; }
  button.primary { background:var(--blue); border-color:var(--blue); color:white; }
  button.primary:hover { background:#174cac; }
  button.danger { color:#a82b35; border-color:#e9c8cc; }
  button.danger:hover { background:#fff1f2; }
  button:disabled { opacity:.48; cursor:not-allowed; }
  :focus-visible { outline:3px solid #80abfa; outline-offset:2px; }
  input[type=checkbox] { accent-color:var(--blue); width:15px; height:15px; margin:0; flex-shrink:0; cursor:pointer; }
  input[type=text],input[type=search],input[type=datetime-local],select { width:100%; min-width:0; min-height:35px; border:1px solid #cbd6e3; border-radius:6px; background:white; padding:6px 9px; color:var(--ink); }
  .workspace { display:grid; grid-template-columns:minmax(0,1.65fr) minmax(340px,1fr); gap:16px; align-items:start; }
  .panel { background:white; border:1px solid var(--line); border-radius:10px; overflow:hidden; }
  .panel-head { display:flex; align-items:center; gap:10px; padding:13px 15px; border-bottom:1px solid var(--line); }
  .panel-head .spacer { flex:1; }
  .step { display:inline-grid; place-items:center; width:23px; height:23px; background:var(--soft); color:var(--blue); border-radius:7px; font-size:12px; font-weight:700; flex-shrink:0; }
  .selection-panel { display:flex; flex-direction:column; min-height:420px; }
  .selection-count { color:var(--blue); font-size:12px; font-weight:600; }
  .cols { display:grid; grid-template-columns:minmax(160px,.7fr) minmax(0,1.5fr); flex:1; min-height:0; }
  .col { display:flex; flex-direction:column; min-width:0; min-height:0; }
  .groups-col { border-right:1px solid var(--line); background:#fbfcfe; }
  .col h3 { padding:12px 12px 4px; }
  .search { padding:7px 12px 10px; }
  .search input { font-size:12px; }
  .col > div[id$="List"] { overflow:auto; min-height:220px; height:320px; flex:none; }
  .row { display:flex; align-items:center; gap:9px; padding:10px 12px; border-bottom:1px solid #eef2f7; min-width:0; }
  .row:hover { background:#f3f7fd; }
  .row.selected { background:var(--soft); }
  button.group-row { width:100%; border:0; border-bottom:1px solid #eef2f7; border-radius:0; text-align:left; font-weight:450; background:transparent; }
  button.group-row[aria-pressed="true"] { background:var(--soft); color:#164eaf; box-shadow:inset 3px 0 var(--blue); font-weight:650; }
  .group-name { overflow-wrap:anywhere; flex:1; }
  label.node-row { cursor:pointer; align-items:flex-start; }
  .node-row input { margin-top:3px; }
  .node-main { min-width:0; flex:1; }
  .node-title { display:flex; align-items:center; gap:7px; font-weight:550; }
  .node-name { overflow-wrap:anywhere; }
  .node-detail { display:block; font-size:11px; color:var(--muted); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; margin-top:3px; }
  .dot { width:7px; height:7px; border-radius:50%; flex-shrink:0; }
  .dot.on { background:#25855c; } .dot.off { background:#9caabd; }
  .node-online { font-size:10px; color:var(--muted); font-weight:400; margin-left:auto; white-space:nowrap; }
  .select-visible { position:sticky; top:0; background:#fbfcfe; z-index:1; font-size:12px; }
  .pill { display:inline-block; background:#eaf0f7; color:#52657b; padding:1px 7px; border-radius:12px; font-size:11px; font-weight:600; white-space:nowrap; }
  .badge { display:inline-flex; align-items:center; border-radius:5px; padding:3px 7px; font-size:11px; font-weight:600; white-space:nowrap; }
  .badge.good { color:#176143; background:#e8f5ed; } .badge.wait { color:#805811; background:#fff4dc; }
  .badge.info { color:#245ca8; background:#ebf3ff; } .badge.bad { color:#a52a39; background:#fff0f1; }
  .badge.neutral { color:#596a80; background:#eef2f7; }
  .empty { text-align:center; color:var(--muted); padding:25px 15px; }
  .selection-foot { display:flex; justify-content:space-between; align-items:center; gap:12px; border-top:1px solid var(--line); padding:9px 12px; font-size:12px; color:var(--muted); }
  .text-button { border:0; color:var(--blue); padding:4px 6px; min-height:27px; background:transparent; }
  .composer { display:flex; flex-direction:column; }
  fieldset { border:0; margin:0; padding:0; min-width:0; }
  .composer-section { padding:13px 16px; }
  .composer-section + .composer-section { border-top:1px solid var(--line); }
  .fields { display:grid; grid-template-columns:1fr; gap:10px; margin-top:11px; }
  .field { display:block; min-width:0; }
  .field > span { display:block; font-size:12px; font-weight:550; margin-bottom:4px; }
  .check-label { display:flex; gap:9px; align-items:center; cursor:pointer; }
  .schedule-switch { padding:10px 0 4px; }
  .schedule-date-wrap { margin-top:9px; }
  #scheduleTimezone { display:block; font-size:11px; color:var(--muted); margin-top:4px; }
  details { margin-top:10px; }
  summary { cursor:pointer; color:#40536a; font-size:12px; padding:5px 0; }
  .advanced-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; padding:9px 0 2px; font-size:12px; }
  .template-tools { display:flex; flex-wrap:wrap; gap:6px; padding-top:7px; }
  .template-tools select { flex:1 1 150px; width:auto; }
  .review { margin-top:auto; border-top:1px solid var(--line); padding:13px 16px; background:#f8faff; }
  .review-label { font-size:10px; letter-spacing:1px; color:var(--muted); text-transform:uppercase; font-weight:650; }
  #operationSummary { font-size:14px; font-weight:600; line-height:1.5; margin:5px 0; overflow-wrap:anywhere; }
  #summaryDetails { font-size:11px; color:var(--muted); margin-bottom:11px; }
  #runBtn { width:100%; min-height:38px; }
  #progress { display:block; font-size:12px; margin-top:7px; color:var(--blue); }
  #progress:empty { display:none; }
  #tasksPanel { margin-top:16px; }
  #tasksPanel .tphead { display:flex; align-items:center; gap:8px; padding:11px 14px; border-bottom:1px solid var(--line); flex-wrap:wrap; }
  .task-tabs { display:flex; gap:4px; }
  .task-tabs button { border-color:transparent; color:var(--muted); }
  .task-tabs button[aria-selected="true"] { color:var(--blue); background:var(--soft); }
  .task-tabs .pill { margin-left:6px; }
  .tphead .spacer { flex:1; }
  #tasksPanel table { width:100%; min-width:650px; border-collapse:collapse; font-size:12px; }
  #tasksPanel th,#tasksPanel td { padding:9px 14px; border-bottom:1px solid #eef2f7; text-align:left; }
  #tasksPanel th { position:sticky; top:0; z-index:1; background:#fafbfd; color:var(--muted); font-size:11px; font-weight:550; }
  #tasksPanel tr:has(input:checked) { background:var(--soft); }
  #tasksPanel tbody tr:hover { background:#f6f9fe; }
  #tasksTableWrap,#scheduledTableWrap { max-height:205px; overflow:auto; }
  #scheduledMessage { font-size:11px; color:var(--muted); padding:7px 14px; }
  #scheduledMessage.error { color:#a52a39; }
  .schedule-date { white-space:nowrap; }
  .scheduled-details { display:block; font-size:11px; color:var(--muted); margin-top:2px; }
  .progress-cell { min-width:120px; }
  .progress-bar { width:85px; height:5px; display:inline-block; background:#e5ecf5; border-radius:5px; overflow:hidden; }
  .progress-fill { background:var(--blue); height:100%; }
  #logs { display:none; white-space:pre-wrap; overflow:auto; max-height:240px; margin-top:16px; padding:15px; border-radius:9px; font:12px/1.7 Menlo,Consolas,monospace; background:#18263b; color:#dce7f8; }
  @media(max-width:1000px) { .workspace { grid-template-columns:1fr; } .selection-panel { min-height:350px; } .col > div[id$="List"] { height:270px; flex:none; } .composer .fields { grid-template-columns:1fr 1fr; } }
  @media(max-width:580px) { body { padding:10px; } .app-head { align-items:flex-start; flex-direction:column; gap:10px; } .brand-mark { display:none; } .cols { grid-template-columns:1fr; } .groups-col { border-right:0; border-bottom:1px solid var(--line); } .groups-col > div[id$="List"] { height:120px; min-height:100px; } .composer .fields,.advanced-grid { grid-template-columns:1fr; } .panel-head { flex-wrap:wrap; } .task-tabs button { padding:6px; font-size:12px; } .tphead .spacer { display:none; } #tasksPanel th,#tasksPanel td { padding:8px; } }
</style>
</head>
<body>
<div class="app">
  <header class="app-head">
    <div class="brand"><span class="brand-mark" aria-hidden="true">F</span><div><h1>FOG Control</h1><p class="help">Déployez et suivez vos tâches depuis MeshCentral.</p></div></div>
    <div class="head-actions"><span id="cfgState" class="badge neutral" role="status">Connexion à FOG…</span><button id="historyBtn">Historique</button><button id="logsBtn" aria-controls="logs" aria-expanded="false">Journal</button></div>
  </header>
  <main class="workspace">
    <section class="panel selection-panel" aria-labelledby="selectionTitle">
      <div class="panel-head"><h2 id="selectionTitle"><span class="step">1</span> Choisir les postes</h2><span class="spacer"></span><span id="selectionCount" class="selection-count" aria-live="polite">Aucun poste sélectionné</span></div>
      <div class="cols">
        <div class="col groups-col"><h3>Groupes</h3><div class="search"><input type="search" id="groupSearch" aria-label="Rechercher un groupe" placeholder="Rechercher un groupe…"></div><div id="groupList"></div></div>
        <div class="col"><h3>Postes <span id="countLabel" class="pill"></span></h3><div class="search"><input type="search" id="nodeSearch" aria-label="Rechercher un poste" placeholder="Rechercher un poste…"></div><div id="nodeList"></div></div>
      </div>
      <div class="selection-foot"><button id="lookupBtn" class="text-button" title="Actualiser les correspondances des postes avec FOG">Actualiser les postes FOG</button><button id="clearSelectionBtn" class="text-button" disabled>Effacer la sélection</button></div>
    </section>
    <section class="panel composer" aria-label="Préparer une tâche">
      <fieldset id="composerFields" aria-label="Paramètres de la tâche">
        <div class="composer-section">
          <h2><span class="step">2</span> Choisir l’action</h2>
          <div class="fields">
            <label class="field" for="actionSel"><span>Action</span><select id="actionSel"><option value="deploy">Déployer une image</option><option value="capture">Capturer une image</option><option value="snapin">Exécuter un snapin</option></select></label>
            <label id="imageWrap" class="field" for="imageSel"><span>Image</span><select id="imageSel"><option value="">Image attribuée à chaque poste</option></select></label>
            <label id="snapinWrap" class="field" for="snapinSel" hidden><span>Snapin</span><select id="snapinSel"><option value="">Chargement…</option></select></label>
          </div>
          <p id="actionHelp" class="help" style="margin-top:8px"></p>
          <details><summary>Modèles d’action</summary><div class="template-tools"><select id="tplSel" aria-label="Charger un modèle"><option value="">Choisir un modèle…</option></select><button id="tplSaveBtn" title="Enregistrer les réglages actuels comme modèle">Enregistrer</button><button id="tplDelBtn" title="Supprimer le modèle sélectionné">Supprimer</button></div></details>
        </div>
        <div class="composer-section">
          <h2><span class="step">3</span> Définir l’exécution</h2>
          <label class="check-label schedule-switch"><input type="checkbox" id="scheduleOn"> Planifier pour plus tard</label>
          <div id="scheduleFields" class="schedule-date-wrap" hidden><label class="field"><span>Date et heure FOG</span><input type="datetime-local" id="scheduleAt" disabled aria-describedby="scheduleTimezone"></label><small id="scheduleTimezone" hidden></small></div>
          <details id="advancedOptions"><summary>Options avancées <span id="advancedCount" class="pill" hidden></span></summary><div class="advanced-grid">
            <label class="check-label"><input type="checkbox" id="optWol"> Réveiller les postes (WoL)</label>
            <label class="check-label"><input type="checkbox" id="optShutdown"> Éteindre après exécution</label>
            <label class="check-label"><input type="checkbox" id="optJoinAd"> Joindre le domaine</label>
            <label class="check-label"><input type="checkbox" id="optForceName"> Appliquer le nom du poste</label>
          </div></details>
        </div>
      </fieldset>
      <div class="review"><div class="review-label">Récapitulatif</div><p id="operationSummary" aria-live="polite">Sélectionnez les postes à préparer.</p><p id="summaryDetails"></p><button id="runBtn" class="primary" disabled>Exécuter sur les postes sélectionnés</button><span id="progress" role="status" aria-live="polite"></span></div>
    </section>
  </main>
  <section id="tasksPanel" class="panel" aria-label="Suivi des tâches FOG">
    <div class="tphead">
      <div class="task-tabs" role="tablist" aria-label="Tâches FOG"><button id="activeTasksTab" role="tab" aria-selected="true" aria-controls="activeTasksPane" tabindex="0">Tâches actives <span id="taskCount" class="pill">0</span></button><button id="scheduledTasksTab" role="tab" aria-selected="false" aria-controls="scheduledTasksPane" tabindex="-1">Tâches planifiées <span id="scheduledCount" class="pill">—</span></button></div>
      <span class="spacer"></span><button id="refreshTasksBtn">Actualiser</button><button id="cancelTasksBtn" class="danger" disabled>Annuler la sélection</button><button id="cancelScheduledBtn" class="danger" hidden disabled>Annuler la sélection</button>
    </div>
    <div id="activeTasksPane" role="tabpanel" aria-labelledby="activeTasksTab"><div id="tasksTableWrap"><table id="tasksTable"><thead><tr><th style="width:32px"><input type="checkbox" id="taskCheckAll" aria-label="Sélectionner toutes les tâches actives"></th><th>Poste</th><th>Type</th><th>État</th><th class="progress-cell">Progression</th><th>ID FOG</th></tr></thead><tbody id="tasksBody"></tbody></table></div></div>
    <div id="scheduledTasksPane" role="tabpanel" aria-labelledby="scheduledTasksTab" hidden><div id="scheduledMessage" role="status" aria-live="polite"></div><div id="scheduledTableWrap"><table id="scheduledTable"><thead><tr><th style="width:32px"><input type="checkbox" id="scheduledCheckAll" aria-label="Sélectionner toutes les tâches planifiées"></th><th>Poste / groupe</th><th>Type / snapin</th><th>Date prévue (heure FOG)</th><th>État</th><th>ID FOG</th></tr></thead><tbody id="scheduledBody"></tbody></table></div></div>
  </section>
  <div id="logs" aria-label="Journal des opérations" style="display:none"></div>
</div>

<script>
(function () {
  var W = window;
  var P = (W.parent && W.parent !== W) ? W.parent : W;

  var state = {
    groups: [],
    nodes: [],
    selectedGroup: null,
    checkedNodes: {},   // nodeid -> true
    fogMap: {},         // nodeid -> { hostId, name, image } or null
    snapins: [],
    images: [],
    taskMap: {},  // hostID -> { type, label, percent, state }
    tasksList: [],     // flat list of active tasks for the Active tasks panel
    checkedTasks: {},  // taskId -> true
    taskTab: 'active',
    scheduledList: [],
    scheduledLoaded: false,
    scheduledLoading: false,
    scheduledError: '',
    checkedScheduledTasks: {},
    cancellingScheduled: false,
    fogTimezone: null,
    fogClockOffset: 0,
    scheduleInfoError: '',
    runBusy: false,
    fogConnected: false
  };

  function $(id) { return document.getElementById(id); }
  function log(msg) {
    var el = $('logs');
    var t = new Date().toLocaleTimeString();
    el.textContent += '[' + t + '] ' + msg + '\n';
    el.scrollTop = el.scrollHeight;
  }
  function showLogs(v) {
    $('logs').style.display = v ? 'block' : 'none';
    $('logsBtn').setAttribute('aria-expanded', String(v));
  }

  // ---- access the MeshCentral nodes/meshes datastructure in the parent frame ----
  function getMeshes() {
    try { return P.meshes || P.window.meshes || {}; } catch (e) { return {}; }
  }
  function getNodes() {
    try { return P.nodes || P.window.nodes || {}; } catch (e) { return {}; }
  }

  function isWindows(node) {
    // MeshCentral agent ids for Windows: 1, 2, 3, 4, 13 (consoles + service variants)
    var winIds = [1, 2, 3, 4, 13];
    return node && node.agent && winIds.indexOf(node.agent.id) !== -1;
  }

  function getNodeMac(node) {
    if (!node) return '';
    if (node.intelamt && node.intelamt.mac) return node.intelamt.mac;
    if (node.netif2) {
      var k;
      for (k in node.netif2) {
        var ifs = node.netif2[k];
        if (Array.isArray(ifs)) {
          for (var i = 0; i < ifs.length; i++) {
            if (ifs[i].mac && ifs[i].mac !== '00:00:00:00:00:00') return ifs[i].mac;
          }
        }
      }
    }
    if (node.mac) return node.mac;
    return '';
  }

  function loadFromMesh() {
    var meshes = getMeshes();
    var nodes = getNodes();
    var gList = [];
    var nList = [];
    var meshId;
    for (meshId in meshes) {
      var m = meshes[meshId];
      if (!m) continue;
      gList.push({ id: meshId, name: m.name || meshId });
    }
    var nid;
    for (nid in nodes) {
      var n = nodes[nid];
      if (!n) continue;
      if (!isWindows(n)) continue;
      // Some MeshCentral builds key `nodes` by short numeric ids and store the
      // canonical "node//..." identifier in `_id`. runcommands needs the long form.
      var fullId = n._id || nid;
      nList.push({
        id: fullId,
        name: n.name || fullId,
        meshid: n.meshid,
        online: !!(n.conn & 1),
        mac: getNodeMac(n)
      });
    }
    gList.sort(function (a, b) { return a.name.localeCompare(b.name); });
    nList.sort(function (a, b) { return a.name.localeCompare(b.name); });
    state.groups = gList;
    state.nodes = nList;
  }

  function taskTypeLabel(label) {
    return { Deploy: 'Déploiement', Capture: 'Capture', Multicast: 'Multidiffusion', Snapin: 'Snapins', 'All Snapins': 'Tous les snapins', 'Single Snapin': 'Snapin individuel' }[label] || label;
  }

  function taskStatus(label) {
    var labels = {
      queued: ['En attente', 'wait'], 'in-progress': ['En cours', 'info'], 'in progress': ['En cours', 'info'],
      running: ['En cours', 'info'], complete: ['Terminée', 'good'], completed: ['Terminée', 'good'],
      cancelled: ['Annulée', 'neutral'], canceled: ['Annulée', 'neutral'], 'checked in': ['Prise en charge', 'info'],
      failed: ['Échec', 'bad'], error: ['Erreur', 'bad'], 'on hold': ['En pause', 'wait'],
      'en attente': ['En attente', 'wait'], 'échéance atteinte': ['Échéance atteinte', 'wait'], 'récurrente': ['Récurrente', 'info']
    };
    var status = labels[String(label).toLowerCase()] || [label || 'État inconnu', 'neutral'];
    return '<span class="badge ' + status[1] + '">' + escapeHtml(status[0]) + '</span>';
  }

  function chosenItem() {
    var action = $('actionSel').value;
    var select = $(action === 'snapin' ? 'snapinSel' : 'imageSel');
    if (action === 'capture') return '';
    if (action === 'deploy' && !select.value) return 'l’image attribuée à chaque poste';
    var item = (action === 'snapin' ? state.snapins : state.images).find(function (it) { return String(it.id) === select.value; });
    return item ? item.name : (action === 'snapin' ? 'le snapin sélectionné' : 'l’image sélectionnée');
  }

  function executionSummary(count) {
    var action = $('actionSel').value;
    var text = action === 'capture' ? 'Capturer une image' : (action === 'snapin' ? 'Exécuter ' : 'Déployer ') + chosenItem();
    text += ' sur ' + count + ' poste' + (count > 1 ? 's' : '');
    if ($('scheduleOn').checked) {
      var parts = $('scheduleAt').value.split('T');
      var date = (parts[0] || '').split('-').reverse().join('/');
      text += parts[1] ? ' · le ' + date + ' à ' + parts[1] + ' — heure FOG (' + state.fogTimezone + ')' : ' · date FOG à choisir';
    } else text += ' · dès que possible';
    return text;
  }

  function updateSummary() {
    var ids = selectedNodeIds();
    var visible = {};
    visibleNodes().forEach(function (n) { visible[n.id] = true; });
    var pending = 0, matched = 0, hidden = 0;
    ids.forEach(function (id) {
      if (state.fogMap[id] === undefined) pending++;
      else if (state.fogMap[id]) matched++;
      if (!visible[id]) hidden++;
    });
    var missing = ids.length - pending - matched;
    $('selectionCount').textContent = ids.length ? ids.length + ' poste' + (ids.length > 1 ? 's sélectionnés' : ' sélectionné') : 'Aucun poste sélectionné';
    $('operationSummary').textContent = ids.length ? executionSummary(ids.length) : 'Sélectionnez les postes à préparer.';
    var details = [];
    if (ids.length) details.push(matched + ' poste' + (matched > 1 ? 's reconnus' : ' reconnu') + ' par FOG');
    if (pending) details.push(pending + ' à vérifier');
    if (missing) details.push(missing + (missing > 1 ? ' absents de FOG, exclus' : ' absent de FOG, exclu') + ' de l’exécution');
    if (hidden) details.push(hidden + (hidden > 1 ? ' sélectionnés' : ' sélectionné') + ' hors du filtre actuel');
    var options = [];
    [['optWol', 'réveil WoL'], ['optShutdown', 'extinction après exécution'], ['optJoinAd', 'jonction au domaine'], ['optForceName', 'application du nom']].forEach(function (o) { if ($(o[0]).checked) options.push(o[1]); });
    if (options.length) details.push('Options : ' + options.join(', '));
    $('summaryDetails').textContent = details.length ? details.join(' · ') : 'Choisissez un groupe, puis cochez les postes concernés.';
    $('advancedCount').hidden = !options.length;
    $('advancedCount').textContent = options.length;
    $('clearSelectionBtn').disabled = !ids.length || state.runBusy;
    $('composerFields').disabled = state.runBusy;
    var scheduled = $('scheduleOn').checked;
    var blocked = !ids.length || (!matched && !pending) || !state.fogConnected || (scheduled && (!state.fogTimezone || !$('scheduleAt').value)) || ($('actionSel').value === 'snapin' && !$('snapinSel').value);
    $('runBtn').disabled = state.runBusy || blocked;
    $('runBtn').textContent = state.runBusy ? 'Envoi en cours…' : (scheduled ? 'Planifier' : 'Exécuter') + (ids.length ? ' sur ' + ids.length + ' poste' + (ids.length > 1 ? 's' : '') : ' sur les postes sélectionnés');
    var all = $('checkAll');
    if (all) {
      var shown = visibleNodes();
      var checked = shown.filter(function (n) { return state.checkedNodes[n.id]; }).length;
      all.checked = shown.length > 0 && checked === shown.length;
      all.indeterminate = checked > 0 && checked < shown.length;
    }
  }

  function updateActionUI() {
    var action = $('actionSel').value;
    $('snapinWrap').hidden = action !== 'snapin';
    $('imageWrap').hidden = action !== 'deploy';
    $('actionHelp').textContent = {
      deploy: 'Installe l’image choisie sur les postes sélectionnés.',
      capture: 'Enregistre le contenu du poste dans son image attribuée dans FOG.',
      snapin: 'Exécute uniquement ce snapin sur les postes sélectionnés.'
    }[action];
    updateSummary();
  }

  function renderGroups() {
    var filter = $('groupSearch').value.toLowerCase();
    var html = '';
    html += '<button class="row group-row" data-gid="__all__" aria-pressed="' + !state.selectedGroup + '"><span class="group-name">Tous les postes</span><span class="pill">' + state.nodes.length + '</span></button>';
    state.groups.forEach(function (g) {
      if (filter && g.name.toLowerCase().indexOf(filter) === -1) return;
      var count = state.nodes.filter(function (n) { return n.meshid === g.id; }).length;
      if (!count) return;
      html += '<button class="row group-row" data-gid="' + escapeHtml(g.id) + '" aria-pressed="' + (state.selectedGroup === g.id) + '"><span class="group-name">' + escapeHtml(g.name) + '</span><span class="pill">' + count + '</span></button>';
    });
    $('groupList').innerHTML = html;
    [].slice.call($('groupList').querySelectorAll('.row')).forEach(function (el) {
      el.onclick = function () {
        var gid = el.getAttribute('data-gid');
        state.selectedGroup = (gid === '__all__') ? null : gid;
        renderGroups();
        renderNodes();
        autoResolveSoon();
      };
    });
  }

  function visibleNodes() {
    var filter = $('nodeSearch').value.toLowerCase();
    return state.nodes.filter(function (n) {
      if (state.selectedGroup && n.meshid !== state.selectedGroup) return false;
      if (filter && n.name.toLowerCase().indexOf(filter) === -1) return false;
      return true;
    });
  }

  function renderNodes() {
    var arr = visibleNodes();
    $('countLabel').textContent = arr.length;
    var html = '<label class="row select-visible"><input type="checkbox" id="checkAll"' + (state.runBusy || !arr.length ? ' disabled' : '') + '> Sélectionner les postes affichés</label>';
    arr.forEach(function (n) {
      var checked = !!state.checkedNodes[n.id];
      var fog = state.fogMap[n.id];
      var detail = fog === undefined ? 'Correspondance FOG à vérifier' : (fog === null ? 'Absent de FOG' : 'FOG #' + fog.id + (fog.image ? ' · ' + fog.image : ''));
      var task = state.taskMap[n.id];
      if (task) detail += ' · ' + taskTypeLabel(task.label) + (task.percent != null ? ' ' + task.percent + '%' : '');
      html += '<label class="row node-row' + (checked ? ' selected' : '') + '">'
        + '<input type="checkbox" data-nid="' + escapeHtml(n.id) + '" aria-label="Sélectionner ' + escapeHtml(n.name) + '"' + (checked ? ' checked' : '') + (state.runBusy ? ' disabled' : '') + '>'
        + '<span class="node-main"><span class="node-title"><span class="dot ' + (n.online ? 'on' : 'off') + '" aria-hidden="true"></span><span class="node-name">' + escapeHtml(n.name) + '</span><span class="node-online">' + (n.online ? 'En ligne' : 'Hors ligne') + '</span></span>'
        + '<span class="node-detail" title="' + escapeHtml(detail) + '">' + escapeHtml(detail) + '</span></span></label>';
    });
    if (!arr.length) html += '<p class="empty">Aucun poste ne correspond à votre recherche.</p>';
    $('nodeList').innerHTML = html;
    [].slice.call($('nodeList').querySelectorAll('input[data-nid]')).forEach(function (cb) {
      cb.onchange = function () {
        var id = cb.getAttribute('data-nid');
        if (cb.checked) state.checkedNodes[id] = true;
        else delete state.checkedNodes[id];
        cb.closest('label').classList.toggle('selected', cb.checked);
        updateSummary();
      };
    });
    $('checkAll').onchange = function () {
      var checked = this.checked;
      arr.forEach(function (n) {
        if (checked) state.checkedNodes[n.id] = true;
        else delete state.checkedNodes[n.id];
      });
      renderNodes();
    };
    updateSummary();
  }

  function escapeHtml(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  function api(action, params) {
    var qs = 'action=' + encodeURIComponent(action);
    if (params) {
      Object.keys(params).forEach(function (k) {
        qs += '&' + encodeURIComponent(k) + '=' + encodeURIComponent(params[k]);
      });
    }
    return fetch('/pluginadmin.ashx?pin=fogctl&' + qs, { credentials: 'include' })
      .then(function (r) { return r.json(); });
  }

  function selectedNodeIds() {
    return Object.keys(state.checkedNodes);
  }

  // Resolve a specific list of nodes against FOG (default: visible nodes not yet
  // resolved). `force=true` re-resolves everything and refreshes the FOG host
  // cache on the server side.
  //
  // We batch in chunks of ~50 items because each entry encodes a full
  // "node//<hash>" identifier — past a couple hundred nodes the URL crosses
  // typical 8 KB limits and the request is silently rejected by the proxy.
  function resolveNodes(nodeList, force) {
    var items = [];
    nodeList.forEach(function (n) {
      if (!force && state.fogMap[n.id] !== undefined) return;
      items.push(encodeURIComponent(n.id) + '|' + encodeURIComponent(n.mac || '') + '|' + encodeURIComponent(n.name || ''));
    });
    if (!items.length) return Promise.resolve();
    var total = items.length;
    log('Recherche de ' + total + ' poste(s) dans FOG…');

    var chunks = [];
    for (var i = 0; i < items.length; i += 50) chunks.push(items.slice(i, i + 50));

    var matched = 0;
    var failed = 0;
    var first = true;

    function runChunk(chunk) {
      var params = { items: chunk.join(',') };
      if (force && first) { params.refresh = '1'; first = false; }
      return api('lookupBulk', params).then(function (r) {
        Object.keys(r).forEach(function (nid) {
          state.fogMap[nid] = r[nid];
          if (r[nid]) matched++;
        });
        renderNodes();
      }).catch(function (e) {
        failed += chunk.length;
        log('Échec de recherche : ' + (e && e.message ? e.message : e));
      });
    }

    return chunks.reduce(function (p, c) { return p.then(function () { return runChunk(c); }); }, Promise.resolve())
      .then(function () {
        log('FOG : ' + matched + '/' + total + ' poste(s) reconnus' + (failed ? ' (' + failed + ' échec(s))' : '') + '.');
      });
  }

  function lookupSelected() {
    return resolveNodes(visibleNodes(), true);
  }

  // Kick off auto-resolution for the currently visible nodes. Debounced to avoid
  // calls during quick group switching.
  var resolveTimer = null;
  function autoResolveSoon() {
    if (resolveTimer) clearTimeout(resolveTimer);
    resolveTimer = setTimeout(function () { resolveNodes(visibleNodes(), false); }, 250);
  }

  // Poll FOG for active tasks. We build a map: nodeId -> task info, by reverse-
  // mapping FOG host id -> nodeId via the fogMap we already built. We also store
  // the raw flat list so the Active tasks panel can render it independently.
  function pollActiveTasks() {
    api('activeTasks').then(function (r) {
      var byFogHost = (r && r.byHost) || {};
      var list = (r && r.tasks) || [];
      var fogToNode = {};
      Object.keys(state.fogMap).forEach(function (nid) {
        var f = state.fogMap[nid];
        if (f && f.id) fogToNode[f.id] = nid;
      });
      var newMap = {};
      Object.keys(byFogHost).forEach(function (hid) {
        var nid = fogToNode[hid];
        if (nid) newMap[nid] = byFogHost[hid];
      });
      var nodesChanged = (JSON.stringify(newMap) !== JSON.stringify(state.taskMap));
      var listChanged = (JSON.stringify(list) !== JSON.stringify(state.tasksList));
      if (nodesChanged) { state.taskMap = newMap; renderNodes(); }
      if (listChanged) { state.tasksList = list; renderTasks(); }
    }).catch(function () { /* silent */ });
  }

  function updateActiveSelection() {
    var count = Object.keys(state.checkedTasks).length;
    $('cancelTasksBtn').disabled = !count;
    $('cancelTasksBtn').textContent = 'Annuler la sélection' + (count ? ' (' + count + ')' : '');
    $('taskCheckAll').checked = state.tasksList.length > 0 && count === state.tasksList.length;
    $('taskCheckAll').indeterminate = count > 0 && count < state.tasksList.length;
    $('taskCheckAll').disabled = !state.tasksList.length;
  }

  function renderTasks() {
    $('taskCount').textContent = state.tasksList.length;
    // Prune checked entries that are no longer running.
    var live = {};
    state.tasksList.forEach(function (t) { live[t.taskId] = true; });
    Object.keys(state.checkedTasks).forEach(function (tid) { if (!live[tid]) delete state.checkedTasks[tid]; });

    var rows = state.tasksList.map(function (t) {
      var ck = state.checkedTasks[t.taskId] ? ' checked' : '';
      var pct = (t.percent != null && t.percent !== '') ? Number(t.percent) : null;
      var pctText = (pct != null && !isNaN(pct)) ? (pct + '%') : '—';
      var pctBar = (pct != null && !isNaN(pct))
        ? '<div class="progress-bar"><div class="progress-fill" style="width:' + Math.max(0, Math.min(100, pct)) + '%"></div></div>'
        : '<span style="color:#888">' + escapeHtml(pctText) + '</span>';
      return '<tr>'
        + '<td><input type="checkbox" aria-label="Sélectionner la tâche active #' + escapeHtml(t.taskId) + '" data-tid="' + escapeHtml(t.taskId) + '"' + ck + '></td>'
        + '<td>' + escapeHtml(t.hostName || ('Poste #' + (t.hostId || '?'))) + '</td>'
        + '<td>' + escapeHtml(taskTypeLabel(t.label)) + '</td>'
        + '<td>' + taskStatus(t.stateName || ('État ' + t.state)) + '</td>'
        + '<td class="progress-cell">' + pctBar + (pct != null ? ' <small>' + pctText + '</small>' : '') + '</td>'
        + '<td>#' + escapeHtml(t.taskId) + '</td>'
        + '</tr>';
    }).join('');
    $('tasksBody').innerHTML = rows || '<tr><td colspan="6" class="empty">Aucune tâche active.</td></tr>';

    [].slice.call($('tasksBody').querySelectorAll('input[type=checkbox][data-tid]')).forEach(function (cb) {
      cb.onclick = function () {
        var tid = cb.getAttribute('data-tid');
        if (cb.checked) state.checkedTasks[tid] = true;
        else delete state.checkedTasks[tid];
        updateActiveSelection();
      };
    });
    var all = $('taskCheckAll');
    if (all) {
      all.checked = state.tasksList.length > 0 && state.tasksList.every(function (t) { return state.checkedTasks[t.taskId]; });
      all.onclick = function () {
        var ck = all.checked;
        state.tasksList.forEach(function (t) {
          if (ck) state.checkedTasks[t.taskId] = true;
          else delete state.checkedTasks[t.taskId];
        });
        renderTasks();
      };
    }
    updateActiveSelection();
  }

  function fogDateInput(timestamp, zone) {
    var parts = {};
    new Intl.DateTimeFormat('en-GB', {
      timeZone: zone, year: 'numeric', month: '2-digit', day: '2-digit',
      hour: '2-digit', minute: '2-digit', hourCycle: 'h23'
    }).formatToParts(new Date(timestamp)).forEach(function (p) { parts[p.type] = p.value; });
    return parts.year + '-' + parts.month + '-' + parts.day + 'T' + parts.hour + ':' + parts.minute;
  }

  function updateScheduleTimezone() {
    var on = $('scheduleOn').checked;
    $('scheduleFields').hidden = !on;
    $('scheduleTimezone').hidden = !on;
    $('scheduleTimezone').textContent = state.fogTimezone ? 'Heure FOG : ' + state.fogTimezone : (state.scheduleInfoError || 'Chargement du fuseau FOG…');
    $('scheduleAt').disabled = !on || !state.fogTimezone;
    $('scheduleAt').style.opacity = $('scheduleAt').disabled ? '0.5' : '1';
    if (on && state.fogTimezone && !$('scheduleAt').value) {
      var next = Math.ceil((Date.now() + state.fogClockOffset + 3600000) / 900000) * 900000;
      $('scheduleAt').value = fogDateInput(next, state.fogTimezone);
    }
    updateSummary();
  }

  function loadScheduleInfo() {
    return api('scheduleInfo').then(function (r) {
      if (!r || r.error || !r.timezone || !Number.isFinite(r.now)) throw new Error(r && r.error || 'Fuseau FOG indisponible');
      fogDateInput(r.now, r.timezone); // Validate timezone support before enabling scheduling.
      state.fogTimezone = r.timezone;
      state.fogClockOffset = r.now - Date.now();
      state.scheduleInfoError = '';
      updateScheduleTimezone();
    }).catch(function (e) {
      state.fogTimezone = null;
      state.scheduleInfoError = e.message;
      updateScheduleTimezone();
      log('Planification indisponible : ' + e.message);
    });
  }

  function updateScheduledSelection() {
    var count = Object.keys(state.checkedScheduledTasks).length;
    var busy = state.cancellingScheduled || state.scheduledLoading;
    $('cancelScheduledBtn').disabled = !count || busy || !!state.scheduledError;
    $('cancelScheduledBtn').textContent = state.cancellingScheduled ? 'Annulation…' : 'Annuler la sélection' + (count ? ' (' + count + ')' : '');
    var all = $('scheduledCheckAll');
    all.checked = state.scheduledList.length > 0 && count === state.scheduledList.length;
    all.indeterminate = count > 0 && count < state.scheduledList.length;
    all.disabled = !state.scheduledList.length || busy || !!state.scheduledError;
  }

  function renderScheduledTasks() {
    var live = {};
    state.scheduledList.forEach(function (t) { live[t.taskId] = true; });
    Object.keys(state.checkedScheduledTasks).forEach(function (id) { if (!live[id]) delete state.checkedScheduledTasks[id]; });
    $('scheduledCount').textContent = state.scheduledLoaded ? state.scheduledList.length : '—';
    var message = $('scheduledMessage');
    message.className = state.scheduledError ? 'error' : '';
    message.textContent = state.scheduledError
      ? 'Actualisation impossible : ' + state.scheduledError + (state.scheduledLoaded ? ' — Dernières données conservées.' : '')
      : (state.scheduledLoading ? 'Chargement…' : 'Dates et heures de votre serveur FOG.');
    var rows = state.scheduledList.map(function (t) {
      var target = t.targetName || ((t.isGroup ? 'Groupe #' : 'Poste #') + t.targetId);
      if (t.isGroup && t.targetName) target = 'Groupe : ' + target;
      var details = '';
      if (t.snapinId) {
        var snapin = state.snapins.find(function (s) { return String(s.id) === String(t.snapinId); });
        details = '<small class="scheduled-details">' + escapeHtml(snapin ? snapin.name : ('Snapin #' + t.snapinId)) + '</small>';
      }
      var status;
      if (t.scheduleType === 'C') {
        status = 'Récurrente';
        details += '<small class="scheduled-details">Cron : ' + escapeHtml(t.cron) + '</small>';
      } else {
        status = t.scheduleTime && t.scheduleTime * 1000 <= Date.now() ? 'Échéance atteinte' : 'En attente';
      }
      var checked = state.checkedScheduledTasks[t.taskId] ? ' checked' : '';
      var disabled = state.cancellingScheduled || state.scheduledLoading || state.scheduledError ? ' disabled' : '';
      return '<tr title="' + escapeHtml(t.name) + '">'
        + '<td><input type="checkbox" data-scheduled-id="' + escapeHtml(t.taskId) + '" aria-label="Sélectionner la tâche planifiée #' + escapeHtml(t.taskId) + '"' + checked + disabled + '></td>'
        + '<td>' + escapeHtml(target) + '</td>'
        + '<td>' + escapeHtml(taskTypeLabel(t.label)) + details + '</td>'
        + '<td class="schedule-date">' + escapeHtml(t.runtime || 'Date indisponible') + '</td>'
        + '<td>' + taskStatus(status) + '</td>'
        + '<td>#' + escapeHtml(t.taskId) + '</td></tr>';
    }).join('');
    var empty = state.scheduledError ? 'Liste indisponible.' : (state.scheduledLoaded ? 'Aucune tâche planifiée en attente.' : 'Chargement…');
    $('scheduledBody').innerHTML = rows || '<tr><td colspan="6" style="text-align:center;color:#888;padding:10px">' + empty + '</td></tr>';
    [].slice.call($('scheduledBody').querySelectorAll('input[data-scheduled-id]')).forEach(function (cb) {
      cb.onchange = function () {
        var id = cb.getAttribute('data-scheduled-id');
        if (cb.checked) state.checkedScheduledTasks[id] = true;
        else delete state.checkedScheduledTasks[id];
        updateScheduledSelection();
      };
    });
    $('scheduledCheckAll').onchange = function () {
      var checked = this.checked;
      state.scheduledList.forEach(function (t) {
        if (checked) state.checkedScheduledTasks[t.taskId] = true;
        else delete state.checkedScheduledTasks[t.taskId];
      });
      renderScheduledTasks();
    };
    updateScheduledSelection();
  }

  function pollScheduledTasks() {
    if (state.scheduledLoading || state.cancellingScheduled) return;
    state.scheduledLoading = true;
    renderScheduledTasks();
    return api('scheduledTasks').then(function (r) {
      if (r && r.error) throw new Error(r.error);
      if (!r || !Array.isArray(r.tasks)) throw new Error('Réponse FOG invalide');
      state.scheduledList = r.tasks;
      state.scheduledLoaded = true;
      state.scheduledError = '';
      state.scheduledLoading = false;
      renderScheduledTasks();
    }).catch(function (e) {
      state.scheduledLoading = false;
      state.scheduledError = e.message;
      renderScheduledTasks();
    });
  }

  function cancelSelectedScheduledTasks() {
    if (state.cancellingScheduled || state.scheduledLoading || state.scheduledError) return;
    var ids = Object.keys(state.checkedScheduledTasks);
    if (!ids.length) return;
    if (!confirm('Annuler ' + ids.length + ' tâche(s) planifiée(s) dans FOG ? Une récurrence sélectionnée sera également supprimée. Si une tâche a déjà démarré, vérifiez l’onglet Tâches actives.')) return;
    state.cancellingScheduled = true;
    renderScheduledTasks();
    return api('cancelScheduled', { taskIds: ids.join(',') }).then(function (r) {
      if (!r || !r.results) throw new Error(r && r.error || 'Réponse FOG invalide');
      var ok = 0, ko = 0;
      ids.forEach(function (id) {
        var result = r.results[id];
        if (result && result.ok) {
          ok++;
          delete state.checkedScheduledTasks[id];
          state.scheduledList = state.scheduledList.filter(function (t) { return String(t.taskId) !== id; });
        } else {
          ko++;
          log('Planification #' + id + ' : ' + (result && result.error || 'Annulation non confirmée'));
        }
      });
      log('Annulation des planifications : ' + ok + ' OK, ' + ko + ' échec(s).');
      if (ko) alert(ko + ' annulation(s) non confirmée(s). Consultez le journal.');
    }).catch(function (e) {
      log('Annulation des planifications impossible : ' + e.message);
      alert('Annulation impossible : ' + e.message);
    }).then(function () {
      state.cancellingScheduled = false;
      return pollScheduledTasks();
    });
  }

  function selectTaskTab(tab) {
    var scheduled = tab === 'scheduled';
    state.taskTab = scheduled ? 'scheduled' : 'active';
    $('activeTasksPane').hidden = scheduled;
    $('scheduledTasksPane').hidden = !scheduled;
    $('cancelTasksBtn').hidden = scheduled;
    $('cancelScheduledBtn').hidden = !scheduled;
    $('activeTasksTab').setAttribute('aria-selected', String(!scheduled));
    $('scheduledTasksTab').setAttribute('aria-selected', String(scheduled));
    $('activeTasksTab').tabIndex = scheduled ? -1 : 0;
    $('scheduledTasksTab').tabIndex = scheduled ? 0 : -1;
    if (scheduled) pollScheduledTasks();
    else pollActiveTasks();
  }

  function taskTabKeydown(event) {
    var tab;
    if (event.key === 'Home') tab = 'active';
    else if (event.key === 'End') tab = 'scheduled';
    else if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') tab = state.taskTab === 'active' ? 'scheduled' : 'active';
    else return;
    event.preventDefault();
    selectTaskTab(tab);
    $(tab === 'active' ? 'activeTasksTab' : 'scheduledTasksTab').focus();
  }

  function showTasks(v) {
    $('tasksPanel').style.display = v ? 'block' : 'none';
    resizeCols();
    if (v) pollActiveTasks();
  }

  function cancelSelectedTasks() {
    var ids = Object.keys(state.checkedTasks);
    if (!ids.length) { alert('Sélectionnez au moins une tâche.'); return; }
    if (!confirm('Annuler les ' + ids.length + ' tâche(s) sélectionnée(s) ?')) return;
    log('Annulation de ' + ids.length + ' tâche(s)…');
    api('cancel', { taskIds: ids.join(',') }).then(function (r) {
      if (r && r.results) {
        var ok = 0, ko = 0;
        Object.keys(r.results).forEach(function (tid) {
          if (r.results[tid].ok) ok++;
          else { ko++; log('  ' + tid + ': ' + r.results[tid].error); }
        });
        log('Annulation terminée : ' + ok + ' OK, ' + ko + ' échec(s).');
      } else if (r && r.error) {
        log('Erreur d’annulation : ' + r.error);
      }
      state.checkedTasks = {};
      updateActiveSelection();
      pollActiveTasks();
    }).catch(function (e) { log('Échec de l’annulation : ' + e.message); });
  }

  function loadImages() {
    return api('imageList').then(function (r) {
      state.images = r.images || [];
      var sel = $('imageSel');
      // Preserve the "Image attribuée à chaque poste" entry.
      sel.innerHTML = '<option value="">Image attribuée à chaque poste</option>';
      state.images.forEach(function (im) {
        var o = document.createElement('option');
        o.value = im.id;
        o.textContent = im.name + (im.os ? ' (' + im.os + ')' : '');
        sel.appendChild(o);
      });
      updateSummary();
    }).catch(function (e) { log('Chargement des images impossible : ' + e.message); });
  }

  function loadSnapins() {
    return api('snapinList').then(function (r) {
      state.snapins = r.snapins || [];
      var sel = $('snapinSel');
      sel.innerHTML = '';
      if (!state.snapins.length) {
        sel.innerHTML = '<option value="">Aucun snapin disponible</option>';
        updateSummary();
        return;
      }
      state.snapins.forEach(function (s) {
        var o = document.createElement('option');
        o.value = s.id;
        o.textContent = s.name;
        sel.appendChild(o);
      });
      if (state.scheduledLoaded) renderScheduledTasks();
      updateSummary();
    }).catch(function (e) { log('Chargement des snapins impossible : ' + e.message); });
  }

  function snapshotOptions() {
    return {
      action:     $('actionSel').value,
      imageId:    $('imageSel').value || '',
      snapinId:   $('snapinSel').value || '',
      wol:        $('optWol').checked,
      shutdown:   $('optShutdown').checked,
      joinAd:     $('optJoinAd').checked,
      forceName:  $('optForceName').checked,
    };
  }
  function applyOptions(o) {
    if (!o) return;
    if (o.action) $('actionSel').value = o.action;
    $('actionSel').onchange();
    if (o.imageId !== undefined) $('imageSel').value = o.imageId;
    if (o.snapinId !== undefined) $('snapinSel').value = o.snapinId;
    $('optWol').checked       = !!o.wol;
    $('optShutdown').checked  = !!o.shutdown;
    $('optJoinAd').checked    = !!o.joinAd;
    $('optForceName').checked = !!o.forceName;
    updateSummary();
  }
  function loadTemplates() {
    api('templates').then(function (r) {
      var sel = $('tplSel');
      while (sel.options.length > 1) sel.remove(1);
      (r.templates || []).forEach(function (t) {
        var o = document.createElement('option');
        o.value = t.id; o.textContent = t.name;
        sel.appendChild(o);
      });
    });
  }
  function saveCurrentAsTemplate() {
    var name = prompt('Nom du modèle :');
    if (!name) return;
    var tpl = snapshotOptions();
    tpl.name = name;
    api('saveTemplate', { payload: encodeURIComponent(JSON.stringify(tpl)) }).then(function (r) {
      if (r.error) return alert('Erreur : ' + r.error);
      loadTemplates();
    });
  }
  function deleteSelectedTemplate() {
    var id = $('tplSel').value;
    if (!id) return alert('Aucun modèle sélectionné.');
    if (!confirm('Supprimer ce modèle ?')) return;
    api('deleteTemplate', { id: id }).then(function (r) {
      if (r.error) return alert('Erreur : ' + r.error);
      loadTemplates();
    });
  }
  function applySelectedTemplate() {
    var id = $('tplSel').value;
    if (!id) return;
    api('templates').then(function (r) {
      var t = (r.templates || []).find(function (x) { return x.id === id; });
      if (t) applyOptions(t);
    });
  }

  function openHistory() {
    api('history').then(function (r) {
      var entries = r.entries || [];
      var html = '<div style="background:#1e1e1e;color:#eee;font-family:monospace;font-size:12px;padding:10px;max-height:60vh;overflow:auto;border-radius:4px">';
      if (!entries.length) html += '(historique vide)';
      else {
        html += '<table style="width:100%;border-collapse:collapse;color:#eee"><thead><tr style="text-align:left">'
              + '<th style="padding:4px;border-bottom:1px solid #555">Quand</th>'
              + '<th style="padding:4px;border-bottom:1px solid #555">Action</th>'
              + '<th style="padding:4px;border-bottom:1px solid #555">Postes</th>'
              + '<th style="padding:4px;border-bottom:1px solid #555">OK/KO</th>'
              + '<th style="padding:4px;border-bottom:1px solid #555">Options</th>'
              + '</tr></thead><tbody>';
        entries.forEach(function (e) {
          var opts = [];
          if (e.scheduleTimezone && e.scheduledFor) opts.push('sched=' + e.scheduledFor + ' FOG (' + e.scheduleTimezone + ')');
          else if (e.scheduleTime) opts.push('sched=' + new Date(e.scheduleTime * 1000).toLocaleString());
          else if (e.scheduledFor) opts.push('sched=' + e.scheduledFor);
          Object.keys(e.results || {}).forEach(function (hostId) {
            var result = e.results[hostId];
            if (result.scheduledTaskId) opts.push(hostId + ': planification #' + result.scheduledTaskId);
            if (result.error) opts.push(hostId + ': ' + result.error);
          });
          if (e.overrideImg) opts.push('img=' + e.overrideImg);
          if (e.snapinId) opts.push('snapin=' + e.snapinId);
          if (e.wol) opts.push('wol');
          if (e.shutdown) opts.push('shutdown');
          html += '<tr>'
                + '<td style="padding:4px;border-bottom:1px solid #333;white-space:nowrap">' + new Date(e.ts).toLocaleString() + '</td>'
                + '<td style="padding:4px;border-bottom:1px solid #333">' + escapeHtml({ deploy: 'Déploiement', capture: 'Capture', snapin: 'Snapin' }[e.kind] || e.kind || '?') + '</td>'
                + '<td style="padding:4px;border-bottom:1px solid #333">' + (e.hostIds || []).length + '</td>'
                + '<td style="padding:4px;border-bottom:1px solid #333"><span style="color:#3c3">' + (e.ok||0) + '</span> / <span style="color:#f44">' + (e.ko||0) + '</span></td>'
                + '<td style="padding:4px;border-bottom:1px solid #333">' + escapeHtml(opts.join(' ')) + '</td>'
                + '</tr>';
        });
        html += '</tbody></table>';
      }
      html += '</div>';
      var win = window.open('', 'fogctl-history', 'width=900,height=600');
      win.document.write('<title>fogctl — Historique</title><body style="font-family:sans-serif;background:#222;color:#eee">' + html + '</body>');
      win.document.close();
    });
  }

  function runAction() {
    if (state.runBusy) return;
    var action = $('actionSel').value;
    var ids = selectedNodeIds();
    if (!ids.length) { alert('Sélectionnez au moins un poste.'); return; }
    var scheduled = $('scheduleOn').checked;
    if (scheduled && (!state.fogTimezone || !$('scheduleAt').value)) {
      alert(state.scheduleInfoError || 'Choisissez une date et une heure FOG.');
      return;
    }
    if (action === 'snapin' && !$('snapinSel').value) { alert('Choisissez un snapin.'); return; }
    state.runBusy = true;
    updateSummary();
    renderNodes();
    var missing = ids.filter(function (id) { return state.fogMap[id] === undefined; });
    // Include selections outside the current group/filter in the lookup.
    var pending = missing.length ? resolveNodes(state.nodes.filter(function (n) { return missing.indexOf(n.id) !== -1; }), false) : Promise.resolve();
    return pending.then(function () {
      var hostIds = [];
      ids.forEach(function (id) {
        var fog = state.fogMap[id];
        if (fog && fog.id && hostIds.indexOf(String(fog.id)) === -1) hostIds.push(String(fog.id));
      });
      if (!hostIds.length) throw new Error('Aucun poste sélectionné n’est reconnu par FOG.');
      var msg = executionSummary(hostIds.length);
      var skipped = ids.filter(function (id) { return !state.fogMap[id]; }).length;
      if (skipped) msg += '\n' + skipped + ' poste(s) absent(s) de FOG seront exclus.';
      var flags = [];
      if ($('optWol').checked) flags.push('réveil WoL');
      if ($('optShutdown').checked) flags.push('extinction après exécution');
      if ($('optJoinAd').checked) flags.push('jonction au domaine');
      if ($('optForceName').checked) flags.push('application du nom du poste');
      if (flags.length) msg += '\nOptions : ' + flags.join(', ') + '.';
      if (!confirm(msg + '\n\nConfirmer cette opération ?')) return;
      $('progress').textContent = 'Envoi aux ' + hostIds.length + ' poste(s)…';
      log(msg);
      var apiAction = action === 'snapin' ? 'snapinRun' : action;
      var extra = { hostIds: hostIds.join(',') };
      if (action === 'deploy' && $('imageSel').value) extra.imageId = $('imageSel').value;
      if (action === 'snapin') extra.snapinId = $('snapinSel').value;
      if (scheduled) {
        extra.scheduledFor = $('scheduleAt').value.replace('T', ' ');
        extra.scheduleMode = 'fog';
        extra.scheduleTimezone = state.fogTimezone;
      }
      if ($('optWol').checked) extra.wol = '1';
      if ($('optShutdown').checked) extra.shutdown = '1';
      var adPre = Promise.resolve();
      if ($('optJoinAd').checked) {
        adPre = adPre.then(function () {
          log('Jonction au domaine sur ' + hostIds.length + ' poste(s)…');
          return api('setupAd', { mode: 'join', hostIds: hostIds.join(',') }).then(function (r) {
            var ok = 0, ko = 0;
            if (r && r.results) Object.keys(r.results).forEach(function (h) { r.results[h].ok ? ok++ : ko++; });
            log('Domaine : ' + ok + ' OK, ' + ko + ' échec(s).');
          });
        });
      }
      if ($('optForceName').checked) {
        adPre = adPre.then(function () {
          log('Application du nom sur ' + hostIds.length + ' poste(s)…');
          return api('setupAd', { mode: 'forceNameChange', hostIds: hostIds.join(',') }).then(function (r) {
            var ok = 0, ko = 0;
            if (r && r.results) Object.keys(r.results).forEach(function (h) { r.results[h].ok ? ok++ : ko++; });
            log('Nom du poste : ' + ok + ' OK, ' + ko + ' échec(s).');
          });
        });
      }
      return adPre.then(function () { return api(apiAction, extra); }).then(function (r) {
        if (!r || !r.results) throw new Error(r && r.error || 'Réponse FOG invalide.');
        var ok = 0, ko = 0;
        hostIds.forEach(function (id) {
          var result = r.results[id];
          if (result && result.ok) {
            ok++;
            if (result.scheduledTaskId) log('Tâche planifiée FOG #' + result.scheduledTaskId + ' pour le poste ' + id);
          } else {
            ko++;
            log('Poste ' + id + ' : ' + (result && result.error || 'Résultat non confirmé'));
          }
        });
        $('progress').textContent = ok + '/' + hostIds.length + (scheduled ? ' planifié(s)' : ' envoyé(s)') + (ko ? ' · ' + ko + ' échec(s), voir le journal' : ' · terminé');
        log('Terminé : ' + ok + ' OK, ' + ko + ' échec(s).');
        if (ko) showLogs(true);
        if (scheduled && ok) selectTaskTab('scheduled');
        else pollActiveTasks();
      });
    }).catch(function (e) {
      $('progress').textContent = 'Opération impossible : ' + e.message;
      log('Erreur : ' + e.message);
      showLogs(true);
    }).then(function () {
      state.runBusy = false;
      updateSummary();
      renderNodes();
    });
  }

  // Resize columns to fill whatever vertical space is available in the *parent*
  // window. MeshCentral's plugin iframe is auto-sized to content, so percent
  // heights and flex:1 don't work — we have to measure the host page and push
  // the column to a concrete pixel height.
  function resizeCols() {
    // Layout is now driven by CSS flex (body is flex column; .cols flex:1).
    // Kept as a no-op so existing callers don't break.
  }

  function init() {
    loadFromMesh();
    renderGroups();
    renderNodes();
    resizeCols();
    window.addEventListener('resize', resizeCols);
    try { W.parent.addEventListener('resize', resizeCols); } catch (e) {}
    setInterval(resizeCols, 1500);

    $('groupSearch').oninput = renderGroups;
    $('nodeSearch').oninput = renderNodes;
    $('lookupBtn').onclick = function () { showLogs(true); lookupSelected(); };
    $('clearSelectionBtn').onclick = function () { state.checkedNodes = {}; renderNodes(); };
    $('runBtn').onclick = runAction;
    $('logsBtn').onclick = function () { showLogs($('logs').style.display === 'none'); resizeCols(); };
    $('historyBtn').onclick = openHistory;
    $('tplSaveBtn').onclick = saveCurrentAsTemplate;
    $('tplDelBtn').onclick = deleteSelectedTemplate;
    $('tplSel').onchange = applySelectedTemplate;
    loadTemplates();
    $('refreshTasksBtn').onclick = function () {
      if (state.taskTab === 'scheduled') pollScheduledTasks();
      else pollActiveTasks();
    };
    $('activeTasksTab').onclick = function () { selectTaskTab('active'); };
    $('scheduledTasksTab').onclick = function () { selectTaskTab('scheduled'); };
    $('activeTasksTab').onkeydown = taskTabKeydown;
    $('scheduledTasksTab').onkeydown = taskTabKeydown;
    $('cancelTasksBtn').onclick = cancelSelectedTasks;
    $('cancelScheduledBtn').onclick = cancelSelectedScheduledTasks;
    renderTasks();
    renderScheduledTasks();
    $('actionSel').onchange = updateActionUI;
    // Trigger once so the initial Deploy selection shows its image dropdown.
    $('actionSel').onchange();

    // Schedule wiring: when the checkbox is on, enable the datetime input and
    // relabel the Run button. Default datetime is now + 1h, rounded to the next
    // 15 minutes — typical for "schedule for tonight" workflows.
    function updateScheduleUI() {
      updateScheduleTimezone();
    }
    $('scheduleOn').onchange = updateScheduleUI;
    $('scheduleAt').oninput = updateScheduleTimezone;
    ['imageSel', 'snapinSel', 'optWol', 'optShutdown', 'optJoinAd', 'optForceName'].forEach(function (id) { $(id).onchange = updateSummary; });
    loadScheduleInfo();

    // Ping the FOG server through the plugin endpoint to surface config issues early.
    api('ping').then(function (r) {
      var el = $('cfgState');
      if (r && r.ok) {
        state.fogConnected = true;
        el.textContent = 'FOG connecté';
        el.className = 'badge good';
        updateSummary();
        loadImages();
        loadSnapins();
        autoResolveSoon();
        pollActiveTasks();
        pollScheduledTasks();
        setInterval(function () {
          pollActiveTasks();
          if (state.taskTab === 'scheduled') pollScheduledTasks();
        }, 8000);
      } else {
        el.textContent = 'FOG indisponible';
        el.className = 'badge bad';
        log('Connexion FOG : ' + (r && r.error || 'serveur inaccessible'));
      }
    }).catch(function () {
      var el = $('cfgState');
      el.textContent = 'Module inaccessible';
      el.className = 'badge bad';
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
</body>
</html>
